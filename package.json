{
  "name": "@uswap/browser-extension",
  "version": "0.6.14",
  "private": true,
  "type": "module",
  "description": "uSwap browser extension (Chrome + Firefox MV3) \u2014 side panel hosting the uSwap app, and the window.peer payment-capture contract for the fiat onramp. Single source, dual target via EXT_TARGET.",
  "scripts": {
    "dev": "vite",
    "dev:firefox": "EXT_TARGET=firefox vite",
    "build": "vite build",
    "build:firefox": "EXT_TARGET=firefox vite build",
    "build:all": "bun run build && bun run build:firefox",
    "package": "bun scripts/zip.ts",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir dist/firefox-artifacts --overwrite-dest",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "run:firefox": "web-ext run --source-dir dist/firefox",
    "test": "bun test test/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zkp2p/sdk": "0.14.10",
    "jsonpath-plus": "^10.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "bun-types": "^1.4.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "web-ext": "^10.7.0"
  },
  "overrides": {
    "brace-expansion": "1.1.21",
    "source-map-js": "1.2.2",
    "undici": "7.30.0",
    "baseline-browser-mapping": "2.11.28",
    "shell-quote": "1.12.0",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "postcss": "8.5.29",
    "ws": "8.22.0",
    "fast-uri": "3.1.8",
    "browserslist": "4.29.3"
  }
}
